# Every API variable named in the HackNC API catalog (generated by
#   python builder/skills/hacknc-api-catalog/scripts/catalog.py env > builder/.env.example)
# Copy to builder/.env (git-ignored) and fill in only what you use. Never commit values.

# alpaca-news (Headers APCA-API-KEY-ID + APCA-API-SECRET-KEY (same paper keys))
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# alpaca-paper-trading (Headers APCA-API-KEY-ID + APCA-API-SECRET-KEY (paper keys differ from live keys))
# also uses ALPACA_API_KEY, ALPACA_SECRET_KEY (above)
BROKER=

# arcgis-location-platform (Query token=<API key> on REST; esriConfig.apiKey or ApiKeyManager.fromKey(key) in JS. Keys come from 'API key credentials' (expire after 1 day to 1 year))
ARCGIS_API_KEY=

# claude-api (Header x-api-key: <key> (SDK reads ANTHROPIC_API_KEY))
ANTHROPIC_API_KEY=

# dialogflow (Authorization: Bearer <OAuth2 token> from a service account (GOOGLE_APPLICATION_CREDENTIALS) or ADC; role roles/dialogflow.client)
GOOGLE_APPLICATION_CREDENTIALS=
DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_LOCATION=
DIALOGFLOW_AGENT_ID=

# elevenlabs (Header xi-api-key: <key>)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=

# faker (None (local library))
FAKER_SEED=

# gemini-api (Header x-goog-api-key: <key> (key from aistudio.google.com/apikey))
GEMINI_API_KEY=
GEMINI_MODEL=

# google-maps-platform (Query ?key=<key> (Maps JS, Geocoding) or header X-Goog-Api-Key: <key> plus required X-Goog-FieldMask (Places New, Routes))
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# here-platform (Query apiKey=<key> on every REST call; new H.service.Platform({apikey}) in JS (OAuth 2.0 bearer tokens are the alternative))
HERE_API_KEY=

# ibm-call-for-code-starter-kits (IBM Cloud IAM API key per service (IamAuthenticator); HERE API key for maps)
ASSISTANT_URL=
ASSISTANT_ID=
ASSISTANT_IAM_APIKEY=
CLOUDANT_ID=
CLOUDANT_IAM_APIKEY=
HERE_APIKEY=
STARTER_KIT_SERVER_URL=

# ibm-watson (IAM: POST https://iam.cloud.ibm.com/identity/token (grant_type=urn:ibm:params:oauth:grant-type:apikey) -> Authorization: Bearer <token>, ~60 min TTL)
IBM_CLOUD_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
NLU_URL=

# kaggle-datasets (Authorization: Bearer $KAGGLE_API_TOKEN (new tokens) or HTTP Basic $KAGGLE_USERNAME:$KAGGLE_KEY (legacy kaggle.json))
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLEHUB_CACHE=

# matlab (MathWorks account sign-in + license association (no API key); Engine API / MCP server attach to a local install)
MW_MCP_SERVER_MATLAB_ROOT=
LD_LIBRARY_PATH=

# meta-graph-api (Authorization: Bearer <user | page | system-user token> (or ?access_token=))
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_TO_NUMBER=
WA_VERIFY_TOKEN=
META_MODE=

# mlh-starter-kits (none for the guides; each sponsor kit needs that sponsor's own key)
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# newsapi (Header X-Api-Key: <key> (or ?apiKey=<key>))
NEWSAPI_KEY=
NEWS_MODE=

# sec-edgar (None; header User-Agent: <Org Name> <contact email>)
SEC_USER_AGENT=

# snowflake (REST (SQL API, Cortex): Authorization: Bearer <PAT> + X-Snowflake-Authorization-Token-Type: PROGRAMMATIC_ACCESS_TOKEN. Python: authenticator=PROGRAMMATIC_ACCESS_TOKEN, token=<PAT> (or key-pair JWT))
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PAT=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_MODE=

# solana (None for RPC; transactions signed with a local ed25519 keypair (64-int JSON array file))
SOLANA_RPC=
SOLANA_KEYPAIR_PATH=

# tiger-data (Postgres user/password over TLS (sslmode=require); default user tsdbadmin, db tsdb. Tiger CLI: browser OAuth (tiger auth login) or TIGER_PUBLIC_KEY / TIGER_SECRET_KEY)
TIGER_DATABASE_URL=

# twilio (HTTP Basic AccountSid:AuthToken (or API Key SID:Secret))
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
PUBLIC_BASE_URL=
TWILIO_MODE=

# x-api (Reads: Authorization: Bearer <app bearer token>. Writes: OAuth 1.0a user context or OAuth 2.0 PKCE user token)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_MODE=

# yelp (Header Authorization: Bearer <API key>)
YELP_API_KEY=
YELP_MODE=

